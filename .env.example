# LLM backend (only OpenAI is supported)
LLM_BACKEND=openai
OPENAI_API_KEY=sk-...          # get one at https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-4o-mini       # or gpt-4o, o3-mini

# Local tools (each team member sets their own paths)
CC=clang
TIGRESS_HOME=/Applications/tigress/3.3.3
TIGRESS_BIN=tigress
TIGRESS_ENVIRONMENT=x86_64:Darwin:Gcc:4.6
GHIDRA_HOME=/path/to/ghidra_12.2_PUBLIC
